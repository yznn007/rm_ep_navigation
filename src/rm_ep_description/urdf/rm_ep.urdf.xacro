<?xml version="1.0"?>
<robot name="robomaster_ep"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- ========== 材质定义 ========== -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>


  <!-- ========== base_link → base ========== -->
  <link name="base_link"/>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>

  <!-- EP 底盘 STL 模型 -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${PI/2.0}"/>
      <geometry>
        <mesh filename="package://rm_ep_description/meshes/visual/base.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ========== 云台 yaw 关节 ========== -->
  <joint name="gimbal_yaw_joint" type="revolute">
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="base"/>
    <child link="gimbal_base"/>
    <limit effort="1000.0" lower="${-1.5*PI}" upper="${1.5*PI}" velocity="${2.0*PI}"/>
  </joint>

  <link name="gimbal_base">
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 ${PI/2.0}"/>
      <geometry>
        <mesh filename="package://rm_ep_description/meshes/visual/gimbal_base.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ========== 云台 pitch 关节 ========== -->
  <joint name="gimbal_pitch_joint" type="revolute">
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <parent link="gimbal_base"/>
    <child link="gimbal_head"/>
    <limit effort="1000.0" lower="${-PI/4.0}" upper="${PI/4.0}" velocity="${2.0*PI}"/>
  </joint>

  <link name="gimbal_head">
    <visual>
      <origin xyz="0 0 -0.165" rpy="0 0 ${PI/2.0}"/>
      <geometry>
        <mesh filename="package://rm_ep_description/meshes/visual/gimbal_head.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ========== 激光雷达 ========== -->
  <link name="laser_link"/>

  <joint name="base_to_laser" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 ${PI}"/>
    <parent link="base_link"/>
    <child link="laser_link"/>
  </joint>

  <!-- ========== IMU ========== -->
  <link name="imu_link"/>

  <joint name="base_to_imu" type="fixed">
    <origin xyz="-0.1 0 0.07" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="imu_link"/>
  </joint>

  <!-- ========== 相机 ========== -->
  <link name="camera_link"/>

  <joint name="head_to_cam" type="fixed">
    <origin xyz="0.0673 0 0.0243" rpy="0 0 0"/>
    <parent link="gimbal_head"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link_optical_frame"/>

  <joint name="cam_to_optical" type="fixed">
    <origin xyz="0 0 0" rpy="${-PI/2.0} 0 ${-PI/2.0}"/>
    <parent link="camera_link"/>
    <child link="camera_link_optical_frame"/>
  </joint>


</robot>
