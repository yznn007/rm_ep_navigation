<launch>
  <!-- RoboMaster EP 底盘驱动 - ROS1 版本 -->
  <!-- 基于 ROS2 robomaster_ros 驱动移植 -->

  <!-- 参数 -->
  <arg name="ep_sn" default="3JKDH3B001891M" doc="RoboMaster EP 序列号"/>
  <arg name="ep_conn_type" default="rndis" doc="连接模式: rndis(USB) / ap(WiFi直连) / sta(路由器)"/>
  <arg name="ep_ip" default="" doc="EP IP 地址"/>
  <arg name="odom_rate" default="20" doc="里程计频率 (Hz)"/>
  <arg name="rviz" default="false" doc="是否启动 RVIZ"/>

  <!-- 底盘驱动节点 -->
  <node name="rm_ep_chassis_driver" pkg="rm_ep_driver" type="rm_ep_chassis_driver.py" output="screen" required="true">
    <param name="ep_sn" value="$(arg ep_sn)"/>
    <param name="ep_conn_type" value="$(arg ep_conn_type)"/>
    <param name="ep_ip" value="$(arg ep_ip)"/>
    <param name="odom_rate" value="$(arg odom_rate)"/>
    <param name="enable_cmd_vel" value="true"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="imu_frame_id" value="imu_link"/>
    <param name="cmd_vel_timeout" value="0.5"/>
    <param name="twist_to_wheel_speeds" value="false"/>
    <param name="force_level" value="false"/>
    <param name="imu_has_orientation" value="true"/>
  </node>

  <!-- RVIZ (可选) -->
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find rm_ep_driver)/rviz/chassis_test.rviz"/>
</launch>
